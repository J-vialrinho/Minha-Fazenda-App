{
  "expo": {
    "name": "Minha Fazenda",
    "slug": "minha-fazenda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minhafazenda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.minhafazenda.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Minha Fazenda usa o microfone para gravar notas de voz nas ocorrências."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.minhafazenda.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B5E20",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Minha Fazenda usa a câmera para ler QR Codes.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withModeloOcr",
      "./plugins/withHttpLocal",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Minha Fazenda usa suas fotos para guardar a foto do animal e os comprovantes de vacina e exame.",
          "cameraPermission": "O Minha Fazenda usa a câmera para fotografar o animal e os comprovantes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B5E20"
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "O Minha Fazenda usa sua localização para mapear áreas e piquetes e para registrar o uso das máquinas.",
          "locationAlwaysAndWhenInUsePermission": "O Minha Fazenda usa sua localização enquanto uma máquina está em uso, mesmo com o app fechado, para registrar tempo, KM e talhões."
        }
      ],
      "@rnmapbox/maps",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "O Minha Fazenda usa o microfone para gravar notas de voz nas ocorrências."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
